{
 "title": "Sprint biomechanics MLOps",
 "uid": "sprintml",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "title": "Requests / s by outcome",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "expr": "sum by (status) (rate(sprintml_requests_total[1m]))",
     "legendFormat": "{{status}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "instant": false,
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 2,
   "title": "End-to-end latency p50 / p95 / p99",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.5, sum by (le) (rate(sprintml_stage_seconds_bucket{stage=\"total\"}[1m])))",
     "legendFormat": "p50",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "instant": false,
     "range": true
    },
    {
     "expr": "histogram_quantile(0.95, sum by (le) (rate(sprintml_stage_seconds_bucket{stage=\"total\"}[1m])))",
     "legendFormat": "p95",
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "instant": false,
     "range": true
    },
    {
     "expr": "histogram_quantile(0.99, sum by (le) (rate(sprintml_stage_seconds_bucket{stage=\"total\"}[1m])))",
     "legendFormat": "p99",
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "instant": false,
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 3,
   "title": "Pose stage latency p50 / p95",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 7,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.5, sum by (le) (rate(sprintml_stage_seconds_bucket{stage=\"pose\"}[1m])))",
     "legendFormat": "p50",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "instant": false,
     "range": true
    },
    {
     "expr": "histogram_quantile(0.95, sum by (le) (rate(sprintml_stage_seconds_bucket{stage=\"pose\"}[1m])))",
     "legendFormat": "p95",
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "instant": false,
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 4,
   "title": "Features + model stage latency p95",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 7,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le) (rate(sprintml_stage_seconds_bucket{stage=\"features\"}[1m])))",
     "legendFormat": "features",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "instant": false,
     "range": true
    },
    {
     "expr": "histogram_quantile(0.95, sum by (le) (rate(sprintml_stage_seconds_bucket{stage=\"model\"}[1m])))",
     "legendFormat": "model",
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "instant": false,
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 5,
   "title": "In-flight requests",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "expr": "sum(sprintml_inflight_requests)",
     "legendFormat": "in flight",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "instant": false,
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value_and_name"
   }
  },
  {
   "id": 6,
   "title": "Champion model version",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 6,
    "y": 14,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "expr": "max(sprintml_model_version)",
     "legendFormat": "version",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "instant": false,
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value_and_name"
   }
  },
  {
   "id": 7,
   "title": "Drift: armed / alarm",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 14,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "expr": "sprintml_drift_armed",
     "legendFormat": "armed",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "instant": false,
     "range": true
    },
    {
     "expr": "sprintml_drift_alarm",
     "legendFormat": "alarm",
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "instant": false,
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 8,
   "title": "Drift: min KS p-value; window n",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 18,
    "y": 14,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "expr": "sprintml_drift_min_p_value",
     "legendFormat": "min p",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "instant": false,
     "range": true
    },
    {
     "expr": "sprintml_drift_window_size",
     "legendFormat": "window n",
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "instant": false,
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  }
 ]
}